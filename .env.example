# ==========================================
# MarkBangla App Configuration (.env.example)
# ==========================================

# 1. MongoDB Database Connection String (MongoDB Atlas or Local MongoDB)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/markbangla?retryWrites=true&w=majority
MONGODB_URI=

# Custom Database Name (Optional, defaults to "markbangla")
MONGODB_DB=markbangla

# 2. GitHub Repository Storage (Optional: Save shared documents directly as commits in your GitHub repo)
# Create a token with 'repo' scope at: https://github.com/settings/tokens
GITHUB_TOKEN=
GITHUB_REPO=AbdullahAlMaksud/markbangla-editor

# 3. Document Encryption Secret (Optional: AES-256-GCM secret key to encrypt documents at rest)
# If not set, a secure deterministic key derived from environment salt will be used.
ENCRYPTION_SECRET=

# 4. Base URL for generating full share links (Optional, defaults to request origin)
# Example in production: https://markbangla.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
